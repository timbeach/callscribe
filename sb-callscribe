#!/bin/sh
# Aegix dwmblocks block for callscribe: recording indicator plus clicks.
# BLOCK_BUTTON 1 opens the GUI, 3 toggles recording. The toggle is detached
# because stop runs whisper for minutes and must never block the bar.
case "${BLOCK_BUTTON:-}" in
1) setsid -f callscribe-gui >/dev/null 2>&1 ;;
3) setsid -f sh -c 'out=$(callscribe toggle 2>&1) || notify-send "callscribe" "$out"; pkill -RTMIN+12 dwmblocks' >/dev/null 2>&1 ;;
esac

status=$(callscribe status 2>/dev/null)
case "$status" in
recording*)
	secs=${status##* }
	secs=${secs%s}
	printf '🔴%d:%02d\n' "$((secs / 60))" "$((secs % 60))"
	;;
*)
	printf '🎙\n'
	;;
esac
