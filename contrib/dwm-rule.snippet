/* Float the callscribe window: add to the rules[] array in
 * ~/.local/src/dwm/config.h, then: cd ~/.local/src/dwm && sudo make clean install
 * and restart dwm (Mod+Shift+Q on Aegix).
 *
 * Tk reports WM_CLASS as instance "callscribe", class "Callscribe"
 * (capitalized), and dwm matches case-sensitively. This is the Aegix/LARBS
 * swallow-patched Rule layout; on vanilla dwm drop the isterminal and
 * noswallow columns.
 *
 *  class          instance      title  tags mask  isfloating  isterminal  noswallow  monitor
 */
	{ "Callscribe",  "callscribe", NULL,  0,         1,          0,          0,         -1 },
