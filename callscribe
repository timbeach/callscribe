#!/bin/sh
# callscribe: record both sides of a call on PipeWire, transcribe locally,
# write one You/Them Markdown transcript. MIT licensed.

usage() {
	cat >&2 <<'EOF'
usage: callscribe <command>

commands:
  start        begin recording mic and system audio
  stop         end recording and produce the transcript
  toggle       start if idle, stop if recording
  status       show whether a recording is running
  transcribe   rerun processing on a finished session
  setup        install whisper.cpp and download a model
  clean        delete raw audio from finished sessions
  summarize    pipe a transcript into the claude CLI
EOF
	exit 1
}

die() {
	printf 'callscribe: %s\n' "$*" >&2
	exit 1
}

# Precedence: environment beats config file beats built-in defaults.
load_config() {
	for v in OUT_DIR MODEL WHISPER_BIN WHISPER_FLAGS LANG SILENCE_DB CLAUDE_BIN STATE_DIR MIC_DEV SYS_DEV; do
		eval "callscribe_set_$v=\${CALLSCRIBE_$v+x}"
		eval "callscribe_val_$v=\${CALLSCRIBE_$v:-}"
	done
	cfg="${XDG_CONFIG_HOME:-$HOME/.config}/callscribe/config"
	# shellcheck disable=SC1090
	[ -r "$cfg" ] && . "$cfg"
	for v in OUT_DIR MODEL WHISPER_BIN WHISPER_FLAGS LANG SILENCE_DB CLAUDE_BIN STATE_DIR MIC_DEV SYS_DEV; do
		if eval "[ -n \"\$callscribe_set_$v\" ]"; then
			eval "CALLSCRIBE_$v=\$callscribe_val_$v"
		fi
	done
	: "${CALLSCRIBE_OUT_DIR:=$HOME/Documents/PERSONAL/meetings}"
	: "${CALLSCRIBE_MODEL:=$HOME/.local/share/callscribe/models/ggml-small.bin}"
	: "${CALLSCRIBE_WHISPER_BIN:=whisper-cli}"
	: "${CALLSCRIBE_WHISPER_FLAGS:=}"
	: "${CALLSCRIBE_LANG:=en}"
	: "${CALLSCRIBE_SILENCE_DB:=-50}"
	: "${CALLSCRIBE_CLAUDE_BIN:=claude}"
	: "${CALLSCRIBE_MIC_DEV:=}"
	: "${CALLSCRIBE_SYS_DEV:=}"
}

# warn_to FILE MESSAGE: print to stderr and record for the transcript.
warn_to() {
	printf 'callscribe: %s\n' "$2" >&2
	printf '%s\n' "$2" >>"$1"
}

state_dir() {
	printf '%s\n' "${CALLSCRIBE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/callscribe}"
}

cmd_status() {
	sd=$(state_dir)
	if [ -f "$sd/current" ]; then
		session=$(cat "$sd/current")
		STARTED_EPOCH=0
		# shellcheck disable=SC1090
		. "$sd/sessions/$session/meta"
		printf 'recording %s %ss\n' "$session" "$(($(date +%s) - STARTED_EPOCH))"
	else
		echo idle
	fi
}

merge_bin() {
	m=$(dirname "$0")/callscribe-merge
	if [ -x "$m" ]; then
		printf '%s\n' "$m"
	else
		command -v callscribe-merge || die "callscribe-merge not found next to callscribe or on PATH"
	fi
}

# process_session DIR: resample, silence-check, transcribe, and merge one session
# into a Markdown transcript in CALLSCRIBE_OUT_DIR. Prints the output path.
process_session() {
	dir=$1
	command -v ffmpeg >/dev/null 2>&1 || die "ffmpeg not found; install ffmpeg"
	command -v "$CALLSCRIBE_WHISPER_BIN" >/dev/null 2>&1 ||
		die "whisper binary '$CALLSCRIBE_WHISPER_BIN' not found; set CALLSCRIBE_WHISPER_BIN or run callscribe setup"
	[ -f "$CALLSCRIBE_MODEL" ] ||
		die "model '$CALLSCRIBE_MODEL' not found; set CALLSCRIBE_MODEL or run callscribe setup"
	SESSION='' STARTED_EPOCH=0 ENDED_EPOCH='' MIC_DEV='' SYS_DEV=''
	# shellcheck disable=SC1090
	. "$dir/meta"
	pwarn="$dir/proc-warnings.log"
	: >"$pwarn"
	for s in mic sys; do
		wav="$dir/$s.wav"
		if [ ! -f "$wav" ]; then
			warn_to "$pwarn" "warning: $s stream has no audio; transcript will be one-sided"
			printf '{"transcription":[]}\n' >"$dir/$s.json"
			continue
		fi
		k16="$dir/$s.16k.wav"
		if ! ffmpeg -nostdin -loglevel error -y -i "$wav" -ar 16000 -ac 1 "$k16"; then
			warn_to "$pwarn" "warning: $s stream audio is unreadable; skipping it"
			printf '{"transcription":[]}\n' >"$dir/$s.json"
			continue
		fi
		mean=$(ffmpeg -nostdin -i "$wav" -af volumedetect -f null - 2>&1 |
			sed -n 's/.*mean_volume: \(-\{0,1\}[0-9.]*\) dB.*/\1/p')
		if [ -z "$mean" ] || [ "$(awk -v m="$mean" -v t="$CALLSCRIBE_SILENCE_DB" 'BEGIN{print (m < t) ? 1 : 0}')" = 1 ]; then
			warn_to "$pwarn" "WARNING: $s stream is silent (mean volume ${mean:-unknown} dB); check your audio routing"
		fi
		# shellcheck disable=SC2086
		"$CALLSCRIBE_WHISPER_BIN" -m "$CALLSCRIBE_MODEL" -l "$CALLSCRIBE_LANG" $CALLSCRIBE_WHISPER_FLAGS \
			-f "$k16" -oj -of "$dir/$s" >>"$dir/whisper.log" 2>&1 ||
			die "whisper failed on $s stream (see $dir/whisper.log)"
		[ -f "$dir/$s.json" ] || die "whisper produced no JSON for $s stream (see $dir/whisper.log)"
	done
	body="$dir/transcript.md"
	"$(merge_bin)" "$dir/mic.json" "$dir/sys.json" >"$body" || die "transcript merge failed"
	mkdir -p "$CALLSCRIBE_OUT_DIR" || die "cannot create $CALLSCRIBE_OUT_DIR"
	end=${ENDED_EPOCH:-$(date +%s)}
	base="$CALLSCRIBE_OUT_DIR/$(date -d "@$STARTED_EPOCH" +%Y-%m-%d-%H%M)-call"
	out="$base.md"
	n=2
	while [ -e "$out" ]; do
		out="$base-$n.md"
		n=$((n + 1))
	done
	{
		printf -- '---\n'
		printf 'date: %s\n' "$(date -d "@$STARTED_EPOCH" +%Y-%m-%d)"
		printf 'start: %s\n' "$(date -d "@$STARTED_EPOCH" +%H:%M)"
		printf 'duration_seconds: %s\n' "$((end - STARTED_EPOCH))"
		printf 'mic_device: %s\n' "$MIC_DEV"
		printf 'sys_device: %s\n' "$SYS_DEV"
		if [ -s "$dir/warnings.log" ] || [ -s "$pwarn" ]; then
			printf 'warnings:\n'
			cat "$dir/warnings.log" "$pwarn" 2>/dev/null | while IFS= read -r w; do
				printf '  - "%s"\n' "$w"
			done
		fi
		printf -- '---\n\n'
		cat "$body"
	} >"$out"
	printf '%s\n' "$out" >"$dir/done"
	PROCESS_OUT=$out
	printf '%s\n' "$out"
}

cmd_transcribe() {
	[ $# -eq 1 ] || die "usage: callscribe transcribe <session-id>"
	sd=$(state_dir)
	dir="$sd/sessions/$1"
	[ -d "$dir" ] || die "no such session: $1"
	if [ -f "$sd/current" ] && [ "$(cat "$sd/current")" = "$1" ]; then
		die "session $1 is still recording; run callscribe stop"
	fi
	process_session "$dir"
}

cmd_start() {
	sd=$(state_dir)
	[ -f "$sd/current" ] && die "already recording session $(cat "$sd/current"); run callscribe stop first"
	if [ -n "$CALLSCRIBE_MIC_DEV" ]; then
		mic_dev=$CALLSCRIBE_MIC_DEV
		pactl list short sources | cut -f2 | grep -qx "$mic_dev" ||
			die "configured mic device '$mic_dev' not found; fix CALLSCRIBE_MIC_DEV or the GUI picker"
	else
		mic_dev=$(pactl get-default-source) || die "cannot read default source: is PipeWire running?"
	fi
	if [ -n "$CALLSCRIBE_SYS_DEV" ]; then
		sys_dev=$CALLSCRIBE_SYS_DEV
		pactl list short sinks | cut -f2 | grep -qx "$sys_dev" ||
			die "configured output device '$sys_dev' not found; fix CALLSCRIBE_SYS_DEV or the GUI picker"
	else
		sys_dev=$(pactl get-default-sink) || die "cannot read default sink: is PipeWire running?"
	fi
	session=$(date +%Y%m%d-%H%M%S)
	dir="$sd/sessions/$session"
	while [ -e "$dir" ]; do
		session="${session}x"
		dir="$sd/sessions/$session"
	done
	mkdir -p "$dir" || die "cannot create $dir"
	{
		printf 'SESSION=%s\n' "$session"
		printf 'STARTED_EPOCH=%s\n' "$(date +%s)"
		printf 'MIC_DEV=%s\n' "$mic_dev"
		printf 'SYS_DEV=%s\n' "$sys_dev"
	} >"$dir/meta"
	# stream.capture.sink captures the sink's monitor (a literal
	# "<sink>.monitor" target is a pulse-only name WirePlumber does not
	# resolve). node.dont-fallback is deliberately absent: on PipeWire
	# 1.6 it breaks the by-name target lookup itself. The printed device
	# names and the silence check at stop guard against a wrong target.
	pw-record --target "$mic_dev" "$dir/mic.wav" >>"$dir/record.log" 2>&1 &
	mic_pid=$!
	pw-record -P stream.capture.sink=true --target "$sys_dev" "$dir/sys.wav" >>"$dir/record.log" 2>&1 &
	sys_pid=$!
	sleep 0.3
	for p in "$mic_pid mic" "$sys_pid system"; do
		set -- $p
		if ! kill -0 "$1" 2>/dev/null; then
			kill -TERM "$mic_pid" "$sys_pid" 2>/dev/null
			die "the $2 recorder exited at launch; see $dir/record.log"
		fi
	done
	{
		printf 'MIC_PID=%s\n' "$mic_pid"
		printf 'SYS_PID=%s\n' "$sys_pid"
	} >"$dir/pids"
	printf '%s\n' "$session" >"$sd/current"
	printf 'recording %s\n  you:  %s\n  them: %s (monitor)\n' "$session" "$mic_dev" "$sys_dev"
}

# stop_recorder PID LABEL DIR: terminate a recorder, but never signal a pid
# that is empty or no longer a recorder (stale state after a crash/reboot).
stop_recorder() {
	if [ -z "$1" ]; then
		warn_to "$3/warnings.log" "warning: $2 recorder has no recorded pid"
		return
	fi
	if [ -r "/proc/$1/cmdline" ] && tr '\0' ' ' <"/proc/$1/cmdline" | grep -q pw-record; then
		kill -TERM "$1" 2>/dev/null
		i=0
		while kill -0 "$1" 2>/dev/null && [ "$i" -lt 50 ]; do
			sleep 0.1
			i=$((i + 1))
		done
		[ "$i" -ge 50 ] && warn_to "$3/warnings.log" "warning: $2 recorder (pid $1) did not exit"
	else
		warn_to "$3/warnings.log" "warning: $2 recorder was not running at stop"
	fi
}

cmd_stop() {
	sd=$(state_dir)
	[ -f "$sd/current" ] || die "no recording in progress"
	session=$(cat "$sd/current")
	dir="$sd/sessions/$session"
	MIC_PID='' SYS_PID=''
	# shellcheck disable=SC1090
	[ -f "$dir/pids" ] && . "$dir/pids"
	: >"$dir/warnings.log"
	stop_recorder "$MIC_PID" mic "$dir"
	stop_recorder "$SYS_PID" system "$dir"
	printf 'ENDED_EPOCH=%s\n' "$(date +%s)" >>"$dir/meta"
	rm -f "$sd/current"
	for f in mic sys; do
		[ -f "$dir/$f.wav" ] || warn_to "$dir/warnings.log" "warning: $f stream has no audio file"
	done
	process_session "$dir"
	if command -v notify-send >/dev/null 2>&1; then
		notify-send "callscribe" "transcript ready: ${PROCESS_OUT:-see $CALLSCRIBE_OUT_DIR}" 2>/dev/null || true
	fi
}

# emit_devices KIND PACTL-TYPE SELECTED: print kind<TAB>name<TAB>desc<TAB>flags rows.
emit_devices() {
	pactl list "$2" | awk -v kind="$1" -v sel="$3" '
		/^\tName: / { name = $2 }
		/^\tDescription: / {
			desc = $0
			sub(/^\tDescription: /, "", desc)
			flags = (name == sel) ? "selected" : ""
			printf "%s\t%s\t%s\t%s\n", kind, name, desc, flags
		}
	'
	if ! pactl list short "$2" 2>/dev/null | cut -f2 | grep -qx "$3"; then
		printf '%s\t%s\t(missing)\tselected,missing\n' "$1" "$3"
	fi
}

cmd_devices() {
	sel_mic=${CALLSCRIBE_MIC_DEV:-$(pactl get-default-source)} || die "cannot read default source"
	sel_sys=${CALLSCRIBE_SYS_DEV:-$(pactl get-default-sink)} || die "cannot read default sink"
	emit_devices source sources "$sel_mic"
	emit_devices sink sinks "$sel_sys"
}

cmd_env() {
	for v in OUT_DIR MODEL WHISPER_BIN WHISPER_FLAGS LANG SILENCE_DB CLAUDE_BIN MIC_DEV SYS_DEV; do
		eval "printf 'CALLSCRIBE_%s=%s\n' \"$v\" \"\$CALLSCRIBE_$v\""
	done
	printf 'CALLSCRIBE_STATE_DIR=%s\n' "$(state_dir)"
}

cmd_toggle() {
	sd=$(state_dir)
	if [ -f "$sd/current" ]; then
		cmd_stop
	else
		cmd_start
	fi
}

cmd_clean() {
	sd=$(state_dir)
	cur=''
	[ -f "$sd/current" ] && cur=$(cat "$sd/current")
	total=0
	for d in "$sd/sessions"/*/; do
		[ -d "$d" ] || continue
		[ -n "$cur" ] && [ "$(basename "$d")" = "$cur" ] && continue
		# Only sessions with a finished transcript lose their audio.
		[ -f "${d}done" ] || continue
		for w in "$d"*.wav; do
			[ -f "$w" ] || continue
			total=$((total + $(wc -c <"$w")))
			rm -f "$w"
		done
	done
	printf 'reclaimed %s KiB of raw audio\n' "$((total / 1024))"
}

cmd_summarize() {
	[ $# -eq 1 ] || die "usage: callscribe summarize <transcript.md>"
	[ -f "$1" ] || die "no such file: $1"
	command -v "$CALLSCRIBE_CLAUDE_BIN" >/dev/null 2>&1 ||
		die "claude CLI '$CALLSCRIBE_CLAUDE_BIN' not found; set CALLSCRIBE_CLAUDE_BIN"
	"$CALLSCRIBE_CLAUDE_BIN" -p \
		'Below is a transcript of a call I was on, labeled You (me) and Them. Write a short summary, the action items with owners, and drafts of any follow-up messages I should send.' \
		<"$1"
}

# ask "question": returns 0 only on an explicit yes.
ask() {
	printf '%s [y/N] ' "$1"
	read -r ans
	case "$ans" in
	y | Y | yes) return 0 ;;
	*) return 1 ;;
	esac
}

cmd_setup() {
	needed=0
	if command -v "$CALLSCRIBE_WHISPER_BIN" >/dev/null 2>&1; then
		printf 'whisper binary: %s (ok)\n' "$(command -v "$CALLSCRIBE_WHISPER_BIN")"
	else
		needed=1
		src="$HOME/.local/src/whisper.cpp"
		ask "whisper-cli is missing. Clone and build whisper.cpp in $src?" || die "setup aborted"
		[ -d "$src" ] || git clone https://github.com/ggml-org/whisper.cpp "$src" || die "clone failed"
		(cd "$src" && make -j "$(nproc)") || die "whisper.cpp build failed; see output above"
		bin=''
		for c in "$src/build/bin/whisper-cli" "$src/whisper-cli" "$src/main"; do
			[ -x "$c" ] && bin=$c && break
		done
		[ -n "$bin" ] || die "built whisper.cpp but found no whisper-cli binary in $src"
		mkdir -p "$HOME/.local/bin"
		ln -sf "$bin" "$HOME/.local/bin/whisper-cli"
		printf 'installed %s -> %s\n' "$HOME/.local/bin/whisper-cli" "$bin"
	fi
	if [ -f "$CALLSCRIBE_MODEL" ]; then
		printf 'model: %s (ok)\n' "$CALLSCRIBE_MODEL"
	else
		needed=1
		name=$(basename "$CALLSCRIBE_MODEL")
		url="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/$name"
		ask "Model $name is missing. Download it from $url to $CALLSCRIBE_MODEL?" || die "setup aborted"
		mkdir -p "$(dirname "$CALLSCRIBE_MODEL")"
		curl -L --fail -o "$CALLSCRIBE_MODEL" "$url" || die "model download failed"
		printf 'downloaded %s\n' "$CALLSCRIBE_MODEL"
	fi
	[ "$needed" -eq 0 ] && printf 'nothing to do: whisper and model are already in place\n'
	return 0
}

main() {
	[ $# -ge 1 ] || usage
	cmd=$1
	shift
	load_config
	case "$cmd" in
	start) cmd_start "$@" ;;
	stop) cmd_stop "$@" ;;
	toggle) cmd_toggle "$@" ;;
	status) cmd_status "$@" ;;
	transcribe) cmd_transcribe "$@" ;;
	devices) cmd_devices "$@" ;;
	env) cmd_env "$@" ;;
	setup) cmd_setup "$@" ;;
	clean) cmd_clean "$@" ;;
	summarize) cmd_summarize "$@" ;;
	*) usage ;;
	esac
}

main "$@"
